# Handshake.sh — environment variables
# Copy to .env and fill in real values. Never commit the actual .env file.

# --- Database (Supabase Postgres) ---
# Use the pooled connection string for the running app (Supabase's pgbouncer
# port, typically 6543) — direct connections don't scale to hundreds of
# concurrent participants hitting the API in a short window.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Prisma Migrate needs a *direct* (non-pooled) connection to run migrations —
# pgbouncer's transaction pooling mode breaks some DDL operations. Supabase
# exposes this on port 5432.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-real-random-secret"
JWT_EXPIRY="12h"
BCRYPT_ROUNDS=12

# --- Handshake codes ---
HANDSHAKE_CODE_LENGTH=6
HANDSHAKE_CODE_EXPIRY_MINUTES=2

# --- CORS ---
# Comma-separated list of allowed origins, e.g.:
# ALLOWED_ORIGINS="https://handshake.sh,https://admin.handshake.sh"
# Required in production — an empty value there rejects all cross-origin
# requests rather than defaulting to "allow everything". In development,
# an empty value permits any origin for local convenience.
ALLOWED_ORIGINS=""

# --- Server ---
PORT=3000
NODE_ENV="development"

# --- Seeding (DO NOT put in .env — pass as one-off env vars) ---
# SEED_PASSWORD and SEED_ALLOW_REMOTE are only needed when running the seed
# script. Pass them inline to avoid persisting credentials:
#   SEED_PASSWORD=your_password SEED_ALLOW_REMOTE=true node prisma/seed.js
